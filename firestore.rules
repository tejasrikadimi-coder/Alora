rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", null) == "admin";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "userId",
          "name",
          "email",
          "subject",
          "message",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "userId",
          "name",
          "email",
          "subject",
          "message",
          "status",
          "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == "New"
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin();

      allow update: if isAdmin()
        && resource.data.status == "New"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status"
        ])
        && request.resource.data.status == "Read";

      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "phone",
          "address",
          "createdAt",
          "role",
          "authProvider"
        ])
        && (
          !request.resource.data.keys().hasAny(["role"])
          || request.resource.data.role == "customer"
        );

      allow update: if (isOwner(userId) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "email",
          "phone",
          "address",
          "updatedAt"
        ]);

      allow delete: if isOwner(userId) || isAdmin();

      match /wishlist/{productId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "productId",
            "createdAt"
          ])
          && request.resource.data.productId == productId
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0;
        allow delete: if isOwner(userId);
      }

      match /cart/{productId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "productId",
            "quantity",
            "updatedAt"
          ])
          && request.resource.data.productId == productId
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0;
        allow delete: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            "id",
            "products",
            "quantity",
            "items",
            "total",
            "payment",
            "customer",
            "phone",
            "email",
            "address",
            "date",
            "status",
            "estimatedDeliveryStart",
            "estimatedDeliveryEnd",
            "userId",
            "stockDeducted",
            "stockRestored",
            "paymentStatus",
            "utr",
            "cancelRequest",
            "returnRequest",
            "exchangeRequest",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "id",
            "products",
            "quantity",
            "items",
            "total",
            "payment",
            "customer",
            "phone",
            "email",
            "address",
            "date",
            "status",
            "estimatedDeliveryStart",
            "estimatedDeliveryEnd",
            "userId",
            "stockDeducted",
            "stockRestored",
            "paymentStatus",
            "utr",
            "cancelRequest",
            "returnRequest",
            "exchangeRequest",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.userId == userId
          && request.resource.data.id == orderId
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 50
          && request.resource.data.products is string
          && request.resource.data.total is string
          && request.resource.data.customer is string
          && request.resource.data.phone is string
          && request.resource.data.email is string
          && request.resource.data.address is string
          && request.resource.data.date is string
          && request.resource.data.estimatedDeliveryStart is string
          && request.resource.data.estimatedDeliveryEnd is string
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && request.resource.data.status == "Order Received"
          && request.resource.data.stockDeducted == false
          && request.resource.data.stockRestored == false
          && request.resource.data.cancelRequest == null
          && request.resource.data.returnRequest == null
          && request.resource.data.exchangeRequest == null
          && (
            (
              request.resource.data.payment == "Cash on Delivery"
              && request.resource.data.paymentStatus == "Pending"
              && (
                !request.resource.data.keys().hasAny(["utr"])
                || request.resource.data.utr == ""
              )
            )
            ||
            (
              request.resource.data.payment == "Online Payment (UPI)"
              && request.resource.data.paymentStatus == "Payment Verification Pending"
              && request.resource.data.utr is string
              && request.resource.data.utr.size() > 0
              && request.resource.data.utr.size() <= 100
            )
          );

        allow update, delete: if isAdmin();

        match /requests/{requestType} {
          allow read: if isOwner(userId) || isAdmin();

          allow create: if isOwner(userId)
            && !exists(/databases/$(database)/documents/users/$(userId)/orders/$(orderId)/requests/$(requestType))
            && get(/databases/$(database)/documents/users/$(userId)/orders/$(orderId)).data.userId == userId
            && request.resource.data.keys().hasOnly([
              "type",
              "reason",
              "status",
              "requestedAt"
            ])
            && request.resource.data.keys().hasAll([
              "type",
              "reason",
              "status",
              "requestedAt"
            ])
            && request.resource.data.type == requestType
            && request.resource.data.type in ["cancel", "return", "exchange"]
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.reason.size() <= 500
            && request.resource.data.status == "Requested"
            && request.resource.data.requestedAt is string
            && (
              (
                requestType == "cancel"
                && get(/databases/$(database)/documents/users/$(userId)/orders/$(orderId)).data.status
                  in ["Order Received", "Confirmed"]
              )
              ||
              (
                requestType in ["return", "exchange"]
                && get(/databases/$(database)/documents/users/$(userId)/orders/$(orderId)).data.status
                  == "Delivered"
              )
            );

          allow update, delete: if isAdmin();
        }
      }
    }
  }
}
